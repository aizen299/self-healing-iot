  <artifactId>edge-device</artifactId>
  <name>edge-device</name>
  <description>
    Simulated IoT/edge device in two variants (constrained, naive) plus the
    multi-device harness. No runtime dependencies beyond common: a logging
    framework on the hot path would allocate, and would confound the Pillar A
    measurements this module exists to support.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.fleet</groupId>
      <artifactId>common</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.paho</groupId>
      <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
    </dependency>
  </dependencies>
</project>
