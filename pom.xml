<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.fleet</groupId>
  <artifactId>self-healing-fleet</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Self-Healing Edge/IoT Fleet Platform</name>
  <description>
    Simulated resource-constrained IoT/edge fleet with automated failure
    detection and recovery. See README.md for the phase build order.
  </description>

  <modules>
    <module>common</module>
    <module>edge-device</module>
    <module>gateway</module>
    <module>stream-processor</module>
    <module>recovery-operator</module>
    <module>tests/integration</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>

    <!-- Pinned to versions already in the local repository so the build
         works offline; see ADR-002 for the JDK pin. -->
    <junit.version>5.10.3</junit.version>
    <surefire.version>3.2.5</surefire.version>
    <enforcer.version>3.4.1</enforcer.version>

    <!-- Pinned for the same reason as the JDK (ADR-002): left to Maven's
         default lifecycle bindings, the plugin that compiles the bytecode
         being measured would change with the installed Maven version, so an
         experiment could be recompiled by a different compiler than the run
         it is compared against. -->
    <compiler.plugin.version>3.15.0</compiler.plugin.version>
    <resources.plugin.version>3.4.0</resources.plugin.version>
    <dependency.plugin.version>3.7.1</dependency.plugin.version>
    <jar.plugin.version>3.4.2</jar.plugin.version>

    <!-- Eclipse Paho MQTT 3.1.1 client; see ADR-004. No transitive
         dependencies, which keeps the edge device's footprint honest. -->
    <paho.version>1.2.5</paho.version>

    <!-- Streaming parser only, not databind: one 572 KB jar with no
         transitive dependencies, and explicit control over how a malformed
         payload is reported. See ADR-005. -->
    <jackson.version>2.17.2</jackson.version>

    <!-- Embedded, pure Java, 2.8 MB and no native libraries; see ADR-007. -->
    <h2.version>2.3.232</h2.version>

    <!-- Matches the broker image pinned in docker-compose.yml. -->
    <kafka.version>3.9.0</kafka.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.fleet</groupId>
        <artifactId>common</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.paho</groupId>
        <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
        <version>${paho.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-core</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>com.h2database</groupId>
        <artifactId>h2</artifactId>
        <version>${h2.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.kafka</groupId>
        <artifactId>kafka-clients</artifactId>
        <version>${kafka.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.kafka</groupId>
        <artifactId>kafka-streams</artifactId>
        <version>${kafka.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.kafka</groupId>
        <artifactId>kafka-streams-test-utils</artifactId>
        <version>${kafka.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${surefire.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${compiler.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${resources.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${dependency.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${jar.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- ADR-002: this machine has several JDKs and the PATH default is a
           GraalVM build. Building on the wrong JVM must fail loudly rather
           than quietly produce measurements that cannot be compared against
           earlier runs. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${enforcer.version}</version>
        <executions>
          <execution>
            <id>enforce-pinned-jvm</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,22)</version>
                  <message>
                    This project is pinned to Java 21 (HotSpot) by ADR-002.
                    Set JAVA_HOME to the pinned JDK before building:
                    export JAVA_HOME=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home
                  </message>
                </requireJavaVersion>

                <!-- A version check alone is not enough: GraalVM 21 is also
                     version 21, and it reports java.vm.name as "Java
                     HotSpot(TM) 64-Bit Server VM", so the obvious checks pass
                     it. ADR-002 rejects Graal because its escape analysis can
                     erase the allocation differences Pillar A measures. The
                     JVMCI marker in java.vm.version is the reliable signal. -->
                <evaluateBeanshell>
                  <condition>
                    !System.getProperty("java.vm.version", "").contains("jvmci")
                    &amp;&amp;
                    !System.getProperty("java.vendor.version", "").contains("GraalVM")
                  </condition>
                  <message>
                    This build is running on a GraalVM JDK, which ADR-002
                    excludes: the Graal JIT's escape analysis can optimise away
                    the allocations that the constrained-vs-naive comparison
                    exists to measure, producing a null result caused by the
                    toolchain. Use the pinned HotSpot JDK:
                    export JAVA_HOME=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home
                  </message>
                </evaluateBeanshell>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
