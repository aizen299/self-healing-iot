# Build outputs
target/
build/
out/
*.class
*.jar
!.mvn/wrapper/maven-wrapper.jar

# Maven
.mvn/wrapper/maven-wrapper.properties.bak

# Gradle
.gradle/
gradle-app.setting
!gradle-wrapper.jar

# IDE
.idea/
*.iml
*.iws
.vscode/
.settings/
.classpath
.project

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# ...except an experiment's own transcript. experiments/results/ is
# deliberately not ignored — the reproducibility contract requires raw and
# processed data to be committed, and the console transcript of the run that
# produced a number is part of that raw record. The blanket rule above was
# quietly swallowing it, which is the kind of gap that turns a committed
# result into an unverifiable one.
!experiments/results/**/*.log

# Env / secrets
.env
.env.*
*.pem
*.key

# Embedded store files written by a local gateway run.
# Experiment data belongs in experiments/results/, not in a scratch database.
data/
*.mv.db
*.trace.db

# JVM crash / profiling artifacts
hs_err_pid*.log
*.hprof

# Kubernetes local state
infrastructure/kubernetes/**/*.local.yaml

# NOTE: experiments/results/ is intentionally NOT ignored.
# Raw and processed experiment data must be committed for reproducibility.
