# Pillar C, experiment 1: what the pipeline costs as the fleet grows.
#
# Read by run-pillar-c-experiment.sh. Every value here is recorded in the
# run's metadata.json.
#
# SCOPE, stated here because it is the first thing a reader should learn:
# this measures throughput, fleet-side and gateway-side resource cost, and
# heartbeat-detection latency against device count. It does NOT measure
# recovery latency against device count — that needs one device per pod, and
# a per-pod JVM's ~64 MB baseline against this host's 8 GB would produce a
# curve describing the laptop. See docs/experiments/pillar-c-scalability.md.

EXPERIMENT_ID=c1-fleet-scalability

# The independent variable.
DEVICE_COUNTS=10 25 50

# Three of each, and the order of the counts reverses on the middle
# repetition so that the largest fleet is not always the one running into a
# warmer machine.
REPETITIONS=3

# The production tick, not Pillar A's accelerated one. This experiment is
# about the pipeline under its real rate with more devices on it, so the rate
# is what stays fixed while the device count moves.
#
# Heartbeats ride the telemetry tick (ADR-006), so the gateway's expected
# interval must be this same number. The runner passes one value to both
# processes rather than trusting two literals to agree.
PUBLISH_INTERVAL_MS=1000

RUN_DURATION_SECONDS=60

# Both variants were measured in Pillar A; the constrained one is what the
# fleet runs, so it is what a scalability curve should describe.
VARIANT=constrained

# The fleet's cap, unchanged from Pillar A and from every device manifest.
HEAP_CAP=64m

# The gateway's cap. Larger than a device's because it holds the registry and
# the embedded store for the whole fleet, and stated because an unstated heap
# is a variable nobody controlled.
GATEWAY_HEAP_CAP=256m

# Every device stops heartbeating 30 readings in — 30 s at this tick, leaving
# 30 s for the gateway to notice and for the sample to be taken. Telemetry
# keeps flowing, which is the point: this is the wedged-device fault that a
# Last Will structurally cannot catch (ADR-006), so it exercises the detection
# path that actually costs the gateway something.
FAILURE_MODE=HEARTBEAT_STOP
FAIL_AFTER_READINGS=30

# 2 missed heartbeats to SUSPECTED, 4 to OFFLINE. The defaults, restated so
# the detection figures can be read against the policy that produced them.
SUSPECT_AFTER_MISSES=2
OFFLINE_AFTER_MISSES=4

# Not 18080/18081: those are the kind cluster's, and an experiment that
# quietly measured a cluster gateway instead of its own would be worse than
# one that failed to start.
GATEWAY_PORT=18090

SEED=42
