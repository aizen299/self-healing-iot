# Pillar A, experiment 1: constrained vs. naive Java under one heap cap.
#
# The project's stated academic contribution, and the last of the three
# pillars to be measured. Both variants have existed since Phase 1 and produce
# byte-identical payloads from the same seed, which is what makes this a
# comparison of engineering discipline rather than of two different programs.
#
# Read by run-pillar-a-experiment.sh. Every value here is recorded in the
# run's metadata.json, so a result can be traced back to the settings that
# produced it without reading this file.

EXPERIMENT_ID=a1-constrained-vs-naive

# The independent variable's constraint: the same cap for both variants. 64 MB
# is the figure the project has used for a constrained device since Phase 1
# (see edge-device/README.md), and it is the number ADR-003's fleet scope was
# chosen against.
#
# Both variants complete at every cap down to 12 MB, so this is not a cap
# either one is straining against. That is deliberate: an experiment that
# only shows the naive variant dying at a cap chosen to kill it would be a
# statement about the cap. What is measured here is what each costs to do the
# same work inside the same allowance.
HEAP_CAP=64m

# ADR-003's fleet scope. Fifty devices in one JVM is the shared-harness
# vehicle, which is the only one where this comparison is possible at all —
# one JVM per device would swamp the difference in per-process baseline, which
# is the reason the shared harness exists (see experiments/environment-baseline.md).
DEVICE_COUNT=50

# Ten times the production tick. The workload the fleet actually runs is one
# reading per device per second; at that rate a run long enough to accumulate
# meaningful allocation takes an hour. This compresses the same total work
# into a practical run, and the figures compared are per-reading or per-run
# costs rather than anything that depends on the rate itself.
#
# Recorded rather than hidden: a reader who thinks the acceleration matters
# can re-run at 1000 and compare, which is the point of committing the runner.
PUBLISH_INTERVAL_MS=100

# Sixty seconds is ~3000 readings per device, and it puts JVM startup and JIT
# warmup at a small fraction of the run without making a five-repetition
# experiment outlast a lunch break.
RUN_DURATION_SECONDS=60

# Five of each variant, alternated. Alternating matters more than the count:
# machine state drifts over ten minutes — thermal, page cache, whatever else
# the laptop decides to do — and running all five of one variant and then all
# five of the other would hand that drift to one side as a result.
REPETITIONS=5

# The sink is COUNTING, not MQTT, and that is not a shortcut. Pillar A
# measures telemetry *production*: the allocation, encoding and threading each
# variant does to turn a sensor reading into bytes. Publishing those bytes
# over a network adds the Paho client's allocation to both sides equally and
# its latency variance to neither usefully. See edge-device/README.md.
SINK=COUNTING

# No faults. This experiment is about steady-state cost; failure behaviour is
# Pillar B's subject and is measured by run-recovery-experiment.sh.
FAILURE_MODE=NONE

# Fixed, so both variants simulate identical sensor values in identical order.
# The payloads are byte-identical between variants at the same seed, which is
# the property that makes "same work" a claim rather than an assumption.
SEED=42
