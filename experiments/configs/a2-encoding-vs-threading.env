# Pillar A, experiment 2: which half of the variant does the work?
#
# a1 compared `constrained` against `naive`, and the two differ in two ways at
# once: how a payload is encoded (a reused buffer and hand-rolled digits, or
# String.format and a fresh byte[] each reading) and how many threads carry it
# (one shared, or one per device). A difference measured between them cannot
# be attributed to either.
#
# This runs the 2x2. Encoding and thread count move independently, so a1's
# result decomposes into the part that is allocation discipline and the part
# that is thread discipline.
#
# Everything else is held at a1's values, so the two experiments are
# comparable and the `constrained/1` and `naive/50` arms should reproduce a1.

EXPERIMENT_ID=a2-encoding-vs-threading

HEAP_CAP=64m
DEVICE_COUNT=50
PUBLISH_INTERVAL_MS=100
RUN_DURATION_SECONDS=60
REPETITIONS=5
SINK=COUNTING
FAILURE_MODE=NONE
SEED=42

# encoding:threads. The first and last reproduce a1's two arms; the middle two
# are the corners a1 never measured.
ARMS="constrained:1 constrained:50 naive:1 naive:50"
