# Pillar B, experiment 1: MTTR under repeated device loss.
#
# The baseline recovery scenario — a device pod disappears and the operator
# provisions a replacement. Repeated so MTTR has a distribution rather than an
# anecdote, which is the whole difference between this and the demonstration
# in Phase 9's README.
#
# Read by run-recovery-experiment.sh. Every value here is recorded in the
# run's metadata.json, so a result can be traced back to the settings that
# produced it without reading this file.

EXPERIMENT_ID=b1-pod-loss

# How the device is made to fail.
#
# pod-loss deletes the pod with --grace-period=0 --force. The force matters:
# a graceful stop lets the device publish a retained SHUTDOWN, which the
# gateway correctly reads as a deliberate stop rather than a failure
# (ADR-006), and no recovery would follow.
FAILURE_MODE=pod-loss

# Samples. Twenty is enough for a median and a p90 to mean something at this
# scale without the run outlasting a coffee: at roughly 12 s per iteration it
# is about four minutes.
ITERATIONS=20

# Long enough for the fleet to settle between samples — the replacement must
# be publishing steadily before the next device is killed, or an iteration
# measures recovery from a fleet that was still recovering.
COOLDOWN_SECONDS=8

# An iteration that has not recovered by now is recorded as a failure rather
# than waited on. Observed recoveries are ~1-2 s, so 60 s is not a threshold
# a healthy run can approach by accident.
RECOVERY_TIMEOUT_SECONDS=60

# Which devices to cycle through. Round-robin rather than always the same
# one, so a result is not a property of device-001's particular pod.
DEVICE_IDS="device-001 device-002 device-003"
